# Bansal Geo Solutions - HRMS & Attendance Environment Configuration
# Production Domains:
# Frontend: https://bansalgeo.geoplanetsolution.in (and https://www.bansalgeo.geoplanetsolution.in)
# Backend API: https://bansalgeo-api.geoplanetsolution.in (and https://www.bansalgeo-api.geoplanetsolution.in)

# Server Configuration
PORT=5000
APP_ENV=production

# JWT Authentication
JWT_SECRET=bansalgeo_hrms_production_jwt_secret_key_2026_super_secure

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bansalgeo_hrms
DB_USER=postgres
DB_PASSWORD=your_password_here

# Frontend Production Domains & CORS Whitelist
FRONTEND_URL=https://bansalgeo.geoplanetsolution.in,https://www.bansalgeo.geoplanetsolution.in,http://localhost:5173,http://localhost:3000
API_URL=https://bansalgeo-api.geoplanetsolution.in

# Office IP / Wi-Fi Network Whitelist (for desktop PCs lacking hardware GPS)
OFFICE_IPS=127.0.0.1,::1,192.168.1.1
