# Bansal Geo HRMS - environment template
# Copy to server/.env (API) and fill in real values. Never commit the real file.

NODE_ENV=production
PORT=5000                      # use 5050 locally on macOS (AirPlay Receiver occupies 5000)

# Long random string (64+ chars). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# PostgreSQL (required in production; the API refuses to start without it)
DB_HOST=
DB_PORT=5432
DB_NAME=bansalgeo
DB_USER=
DB_PASSWORD=
DB_SSL=false

# Browser origins allowed to call the API (comma separated)
FRONTEND_URL=https://bansalgeo.geoplanetsolution.in,https://www.bansalgeo.geoplanetsolution.in

# Business time zone for attendance dates (default Asia/Kolkata)
TZ=Asia/Kolkata

# The office's PUBLIC internet IP(s), so desktop PCs without GPS can punch from the office network.
# Private/loopback addresses (127.x, 10.x, 192.168.x) are ignored in production. A range: "203.0.113."
OFFICE_IPS=

# Frontend build (optional): API base URL; defaults to /api or the production API host
# VITE_API_URL=https://bansalgeo-api.geoplanetsolution.in/api
